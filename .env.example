# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quantdb
MLFLOW_DB_URL=postgresql://postgres:postgres@postgres:5432/mlflowdb

# External API Keys
ALPHA_VANTAGE_KEY=
FRED_API_KEY=
NEWS_API_KEY=

# Data Settings
DATA_START_DATE=2015-01-01
DATA_UPDATE_MODE=incremental
DATA_REFRESH_INTERVAL_HOURS=24

# Market Universe
MARKET=NSE
STOCK_UNIVERSE=NIFTY500

# ML Settings
MODEL_LOOKBACK_WINDOW=252
MODEL_PREDICTION_HORIZON=1
MODEL_RETRAIN_INTERVAL_DAYS=7

# Backtesting
TRANSACTION_COST=0.001
SLIPPAGE=0.0005

# Portfolio
PORTFOLIO_RISK_FREE_RATE=0.07
MAX_POSITION_SIZE=0.05

# Pipeline Automation
PIPELINE_RUN_TIME=18:30
PIPELINE_TIMEZONE=Asia/Kolkata

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/pipeline.log
# Machine learning and signal research
MLFLOW_EXPERIMENT_NAME=quant-ai-platform
FEATURES_DIR=data/features
PREDICTIONS_DIR=data/predictions
SIGNALS_DIR=data/signals
MODEL_ARTIFACT_DIR=models/artifacts
DEFAULT_TARGET_COLUMN=future_return_1d
ML_FEATURE_POLICY=scale_free
SCALE_FREE_FEATURE_COLUMNS=["rsi_14","roc_5","roc_10","volatility_10","volatility_20","volatility_50","bollinger_width","zscore_20","distance_from_sma","distance_from_ema","volume_ratio"]
TRAIN_RATIO=0.70
VALIDATION_RATIO=0.15
TEST_RATIO=0.15
WALK_FORWARD_INITIAL_TRAIN_SIZE=252
WALK_FORWARD_TEST_SIZE=21
WALK_FORWARD_STEP_SIZE=21
RANDOM_SEED=42
RETRAIN_INTERVAL_DAYS=7
SIGNAL_THRESHOLD=0.01
TOP_N=10
LINEAR_REGRESSION_PARAMS={}
RIDGE_PARAMS={"alpha":1.0}
LASSO_PARAMS={"alpha":0.001,"max_iter":10000}
RANDOM_FOREST_PARAMS={"n_estimators":200,"min_samples_leaf":2}
GRADIENT_BOOSTING_PARAMS={"n_estimators":100,"learning_rate":0.05,"max_depth":2}
XGBOOST_PARAMS={"n_estimators":200,"max_depth":3,"learning_rate":0.05}
LIGHTGBM_PARAMS={"n_estimators":200,"num_leaves":15,"learning_rate":0.05}
